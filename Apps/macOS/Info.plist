<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>$(KNOT_DISPLAY_NAME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(KNOT_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>LSUIElement</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>KnotAppGroup</key>
	<string>$(KNOT_MAC_APP_GROUP)</string>
	<key>KnotCloudContainer</key>
	<string>$(KNOT_CLOUD_CONTAINER)</string>
	<key>KnotDevStoreFolder</key>
	<string>$(KNOT_WORKTREE_ID)</string>
	<key>KnotFlavour</key>
	<string>$(KNOT_FLAVOUR)</string>
	<key>KnotMilestoneLevel</key>
	<string>$(KNOT_MILESTONE_LEVEL)</string>
	<key>KnotSourceURL</key>
	<string>https://github.com/p3ob7o/knot</string>
	<key>KnotSyncAvailable</key>
	<string>$(KNOT_SYNC_AVAILABLE)</string>
	<key>KnotWorktree</key>
	<string>$(KNOT_WORKTREE)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Knot records what you say and keeps it as a note on this device.</string>
</dict>
</plist>
